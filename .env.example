# Configuracion de ejemplo. Copiar a `.env` y ajustar en cada entorno.
# NUNCA versionar el archivo `.env` (esta en .gitignore).

# Puerto expuesto por la aplicacion (host)
APP_PORT=3000

# Secreto usado para firmar el hash de las sesiones. Cambiar en produccion.
SESSION_SECRET=dev-secret-cambiar-en-produccion

# Usuario administrador sembrado al primer arranque
ADMIN_USER=admin
ADMIN_PASSWORD=admin123
ADMIN_NAME=Administrador

# Usuario cajero sembrado al primer arranque
CAJERO_USER=cajero
CAJERO_PASSWORD=cajero123
CAJERO_NAME=Cajero Principal
